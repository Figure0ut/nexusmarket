# Set default behavior to handle line endings automatically.
* text=auto

# Source code files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Executable scripts
/mvnw text eol=lf
*.cmd text eol=crlf
*.sh text eol=lf

# Binary files
*.jar binary
*.war binary
*.png binary
*.jpg binary
